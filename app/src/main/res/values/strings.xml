    <string name="tour_how">HOW TO USE</string>
    <string name="tour_t1">Focus with timers</string>
    <string name="tour_d1">Simple timers, Pomodoro with breaks, or your own sequence of steps.</string>
    <string name="tour_s1a">Tap + on the Timers screen</string>
    <string name="tour_s1b">Pick a length, like 25 min, or choose Pomodoro</string>
    <string name="tour_s1c">Press Start. Breaks and alarms are handled for you</string>
    <string name="tour_t2">Track your study hours</string>
    <string name="tour_d2">See how much you study each day, keep your streak and earn badges.</string>
    <string name="tour_s2a">Make a project for each subject in Projects</string>
    <string name="tour_s2b">Choose the project when you make a timer</string>
    <string name="tour_s2c">See hours, calendar and badges in History</string>
    <string name="tour_t3">Stay in the zone</string>
    <string name="tour_d3">Calm sounds and focus tools help you study without distractions.</string>
    <string name="tour_s3a">Settings › Background sound: rain, piano, guitar and more</string>
    <string name="tour_s3b">Silence your phone while you focus</string>
    <string name="tour_s3c">Strict mode: no pausing until the session ends</string>
    <string name="tour_t4">Wake up on time</string>
    <string name="tour_d4">Alarms with rising volume and wake-up missions, so you really get up.</string>
    <string name="tour_s4a">Tap the alarm clock on the Timers screen</string>
    <string name="tour_s4b">Set the time, the days and a snooze length</string>
    <string name="tour_s4c">Add a mission, like math or shaking, to turn it off</string>
    <string name="tour_t5">You\'re all set!</string>
    <string name="tour_d5">Pick your look, then start your first focus.</string>
