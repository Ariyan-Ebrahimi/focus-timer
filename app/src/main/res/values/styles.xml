<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type: Nunito variable font at different weights -->
    <style name="TxBlack">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:fontVariationSettings">\'wght\'900</item>
        <item name="android:textColor">?attr/textMain</item>
    </style>

    <style name="TxBold">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:fontVariationSettings">\'wght\'800</item>
        <item name="android:textColor">?attr/textMain</item>
    </style>

    <style name="TxBody">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:fontVariationSettings">\'wght\'600</item>
        <item name="android:textColor">?attr/textSub</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DlgTitle" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/textMain</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="DlgButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/accent</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SectionLabel" parent="TxBold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textColor">?attr/textSub</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Cards -->
    <style name="ClayCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:tag">clay:surface:30:5</item>
    </style>

    <!-- Settings rows -->
    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">66dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="SettingsIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginEnd">18dp</item>
        <item name="android:tint">?attr/textSub</item>
    </style>

    <style name="SettingsTitleInner" parent="TxBold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsTitle" parent="SettingsTitleInner">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="SettingsSub" parent="TxBody">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SegItem" parent="TxBold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="RowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1.5dp</item>
        <item name="android:layout_marginStart">58dp</item>
        <item name="android:layout_marginEnd">18dp</item>
        <item name="android:background">?attr/strokeC</item>
    </style>

    <style name="PillButton" parent="TxBold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:tag">clay:accent:-1:3:p</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Stat tiles -->
    <style name="Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="TileLabel" parent="TxBold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/textSub</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TileValue" parent="TxBlack">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">24sp</item>
    </style>

    <!-- Bottom nav -->
    <style name="NavTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>

    <style name="NavIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="NavLabel" parent="TxBold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
