<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="18dp">
    <layer-list>
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="32dp" />
                <gradient android:angle="315" android:startColor="?attr/surface"
                    android:endColor="?attr/surface2" />
            </shape>
        </item>
        <item android:bottom="3dp" android:left="2dp" android:right="3dp" android:top="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="30dp" />
                <solid android:color="?attr/surface" />
            </shape>
        </item>
    </layer-list>
</inset>
